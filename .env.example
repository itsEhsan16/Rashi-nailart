# ─────────────────────────────────────────────────────────────────────────────
# Rashi Nail Art Studio — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# On Vercel, set these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public — safe to expose to the browser) ───────────────────────────
# Project URL and the "anon"/publishable key. Found in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# ── Supabase (server only — NEVER expose to the browser) ────────────────────────
# Same URL again (server-side), plus the service-role key that bypasses RLS.
# Used only by server actions / route handlers for trusted writes.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Payments · Cashfree Payment Gateway ─────────────────────────────────────────
# Booking/membership fees are collected through Cashfree's hosted checkout and the
# booking auto-confirms on a signed webhook (no manual verification). Get these
# from Cashfree Dashboard → Developers → API Keys. Use SANDBOX keys locally.
#
# CASHFREE_APP_ID / CASHFREE_SECRET_KEY are SERVER-ONLY — never expose them.
# The secret key doubles as the webhook HMAC secret (Cashfree has no separate one).
CASHFREE_APP_ID="your-cashfree-app-id"
CASHFREE_SECRET_KEY="your-cashfree-secret-key"
# Optional: pin the Cashfree API version (code defaults to 2025-01-01).
# CASHFREE_API_VERSION="2025-01-01"
#
# Public — selects sandbox vs production for BOTH the browser SDK and server base URL.
NEXT_PUBLIC_CASHFREE_MODE="sandbox"   # sandbox | production
#
# Webhook URL to register in Cashfree Dashboard → Developers → Webhooks:
#   {NEXT_PUBLIC_SITE_URL}/api/webhooks/cashfree
# Locally, expose it with a tunnel (e.g. ngrok) so Cashfree can reach it.

# ── Site ────────────────────────────────────────────────────────────────────────
# Public base URL of the deployment (used for SEO metadata / absolute URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
